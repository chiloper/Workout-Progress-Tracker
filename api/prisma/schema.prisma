datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "cjs"
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  ARMS
  LEGS
  CORE
  FULL_BODY
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  exercises    Exercise[]
  workouts     Workout[]

  @@map("users")
}

model Exercise {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  name        String
  muscleGroup MuscleGroup @map("muscle_group")
  isArchived  Boolean     @default(false) @map("is_archived")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSets WorkoutSet[]

  @@unique([userId, name])
  @@map("exercises")
}

model Workout {
  id              String   @id @default(ulid())
  userId          String   @map("user_id")
  title           String?
  performedAt     DateTime @map("performed_at") @db.Timestamptz(3)
  durationMinutes Int?     @map("duration_minutes")
  note            String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSets WorkoutSet[]

  @@index([userId, performedAt(sort: Desc)])
  @@map("workouts")
}

model WorkoutSet {
  id            String  @id @default(ulid())
  workoutId     String  @map("workout_id")
  exerciseId    String  @map("exercise_id")
  exerciseOrder Int     @map("exercise_order")
  setNo         Int     @map("set_no")
  weightKg      Decimal @map("weight_kg") @db.Decimal(6, 2)
  reps          Int

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutId, exerciseId, setNo])
  @@index([exerciseId])
  @@map("workout_sets")
}
